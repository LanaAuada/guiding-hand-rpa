<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_GuidingHand" targetNamespace="http://guidinghand.fiap/rpa">
  <bpmn:process id="Processo_ConfirmarBarreiras" name="Guiding Hand - Confirmar barreiras e atualizar mapa" isExecutable="false">
    <bpmn:startEvent id="Inicio" name="Agendado (diário, 06h)">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer1"><bpmn:timeCycle>0 6 * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Carregar estado do mapa de barreiras">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Listar fontes (API dos óculos + pasta de entrada)">
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW1">
      <bpmn:incoming>F3</bpmn:incoming><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Ler próxima fonte (API: até 3 tentativas)">
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW2" name="Leitura OK?">
      <bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Registrar erro e mover arquivo para quarentena">
      <bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW3">
      <bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T5" name="Validar próxima detecção (R1 a R4)">
      <bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW4" name="Válida, inédita, fixa e confiança &#8805; 0,5?">
      <bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Agrupar na célula de ~30 m e anonimizar óculos (R5)">
      <bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Registrar descarte e motivo no log">
      <bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW5" name="Mais detecções?">
      <bpmn:incoming>F12</bpmn:incoming><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW6" name="Mais fontes?">
      <bpmn:incoming>F15</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T8" name="Decidir status de cada barreira (R6 a R8)">
      <bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Loop1" />
    </bpmn:task>
    <bpmn:task id="T9" name="Salvar estado e mover arquivos para processados">
      <bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Publicar mapa GeoJSON e relatório CSV">
      <bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA1"><bpmn:targetRef>DS_Mapa</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA2"><bpmn:targetRef>DO_Relatorio</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T11" name="Gravar log e trilha de auditoria">
      <bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fim" name="Mapa atualizado">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Mapa" name="mapa_barreiras.geojson (App/MVP)" />
    <bpmn:dataObjectReference id="DO_Relatorio" name="Relatório CSV (zeladoria)" dataObjectRef="DataObj1" />
    <bpmn:dataObject id="DataObj1" />

    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="GW1" />
    <bpmn:sequenceFlow id="F4" sourceRef="GW1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="GW2" />
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="GW2" targetRef="GW3" />
    <bpmn:sequenceFlow id="F7" name="não" sourceRef="GW2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" sourceRef="GW3" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" sourceRef="T5" targetRef="GW4" />
    <bpmn:sequenceFlow id="F10" name="sim" sourceRef="GW4" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" name="não" sourceRef="GW4" targetRef="T7" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6" targetRef="GW5" />
    <bpmn:sequenceFlow id="F13" sourceRef="T7" targetRef="GW5" />
    <bpmn:sequenceFlow id="F14" name="sim" sourceRef="GW5" targetRef="GW3" />
    <bpmn:sequenceFlow id="F15" name="não" sourceRef="GW5" targetRef="GW6" />
    <bpmn:sequenceFlow id="F16" sourceRef="T4" targetRef="GW6" />
    <bpmn:sequenceFlow id="F17" name="sim" sourceRef="GW6" targetRef="GW1" />
    <bpmn:sequenceFlow id="F18" name="não" sourceRef="GW6" targetRef="T8" />
    <bpmn:sequenceFlow id="F19" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F20" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F21" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F22" sourceRef="T11" targetRef="Fim" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagrama1">
    <bpmndi:BPMNPlane id="Plano1" bpmnElement="Processo_ConfirmarBarreiras">
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="40" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="20" y="165" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="110" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="250" y="100" width="110" height="80" /></bpmndi:BPMNShape>
