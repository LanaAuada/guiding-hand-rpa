      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1100" y="140" /><di:waypoint x="1130" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="990" y="270" /><di:waypoint x="1155" y="270" /><di:waypoint x="1155" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1155" y="115" /><di:waypoint x="1155" y="60" /><di:waypoint x="715" y="60" /><di:waypoint x="715" y="115" /><bpmndi:BPMNLabel><dc:Bounds x="926" y="42" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1180" y="140" /><di:waypoint x="1210" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="1184" y="146" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="635" y="310" /><di:waypoint x="635" y="350" /><di:waypoint x="1235" y="350" /><di:waypoint x="1235" y="165" /></bpmndi:BPMNEdge>
