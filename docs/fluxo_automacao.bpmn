      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="470" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW2_di" bpmnElement="GW2" isMarkerVisible="true"><dc:Bounds x="610" y="115" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="602" y="92" width="66" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="580" y="230" width="110" height="80" /></bpmndi:BPMNShape>
