      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="770" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW4_di" bpmnElement="GW4" isMarkerVisible="true"><dc:Bounds x="910" y="115" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="880" y="72" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="990" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="880" y="230" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW5_di" bpmnElement="GW5" isMarkerVisible="true"><dc:Bounds x="1130" y="115" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1163" y="84" width="50" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW6_di" bpmnElement="GW6" isMarkerVisible="true"><dc:Bounds x="1210" y="115" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1188" y="172" width="42" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1290" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="1430" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T10_di" bpmnElement="T10"><dc:Bounds x="1570" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T11_di" bpmnElement="T11"><dc:Bounds x="1710" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fim_di" bpmnElement="Fim"><dc:Bounds x="1852" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1830" y="165" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Mapa_di" bpmnElement="DS_Mapa"><dc:Bounds x="1550" y="235" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1515" y="292" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_Relatorio_di" bpmnElement="DO_Relatorio"><dc:Bounds x="1672" y="235" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1650" y="292" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="76" y="140" /><di:waypoint x="110" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="220" y="140" /><di:waypoint x="250" y="140" /></bpmndi:BPMNEdge>
