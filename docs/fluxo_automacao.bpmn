      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="440" y="140" /><di:waypoint x="470" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="580" y="140" /><di:waypoint x="610" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="660" y="140" /><di:waypoint x="690" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="664" y="146" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="635" y="165" /><di:waypoint x="635" y="230" /><bpmndi:BPMNLabel><dc:Bounds x="641" y="190" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="740" y="140" /><di:waypoint x="770" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="880" y="140" /><di:waypoint x="910" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="960" y="140" /><di:waypoint x="990" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="964" y="146" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
